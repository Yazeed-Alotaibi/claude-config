{
  "autoUpdatesChannel": "latest",
  "theme": "dark",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\yazot\\AppData\\Local\\hermes\\hermes-agent\\venv\\Scripts\\headroom.exe proxy --port 8787 --no-telemetry --detach 2>nul || exit 0",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "C:\\Users\\yazot\\AppData\\Local\\hermes\\hermes-agent\\venv\\Scripts\\headroom.exe init hook ensure",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "headroom init hook ensure",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
