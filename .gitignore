# ===== أسرار — لا ترفع أبداً =====
.credentials.json
*.key
*.pem
.env
.env.*
session-env/

# ===== حالة خاصة بالجهاز (لا تُزامَن) =====
cache/
telemetry/
downloads/
backups/
sessions/
history.jsonl
.last-cleanup
.last-update-result.json
mcp-needs-auth-cache.json
settings.local.json
nul

# ===== جلسات المشاريع (ضخمة) — لكن احتفظ بالذاكرة =====
projects/**
!projects/**/
!projects/**/memory/**

# ===== مستودعات مستنسخة داخل .claude (لها git خاص بها) =====
/ECC/
/ECC-fresh/
/agent-browser/
/agent-skills/
/awesome-mcp-servers/
/claude-plugins-official/
/open-notebook/
/headroom/
/Understand-Anything/
/last30days-skill/
/plugins/repos/
/plugins/cache/
/plugins/marketplaces/

# ===== ملفات وقت التشغيل لأدوات مساعدة (خاصة بالجهاز) =====
.serena/
shell-snapshots/
# أقفال IDE — تحتوي على authToken و PID
/ide/
# مخرجات تشخيصية لسطر الحالة (تحتوي معرّف الجلسة والتكلفة)
.statusline-last.json
# مولّد تلقائياً، يحتوي مسار claude.exe الخاص بالجهاز
/chrome/

# ===== سكيلز مثبّتة عبر `npx skills add` =====
# روابط رمزية إلى ~/.agents/skills بمسار مطلق — تنكسر على الأجهزة الأخرى.
# ثبّتها على كل جهاز بـ: npx skills add mvanhorn/last30days-skill -g
/skills/last30days

# ===== حالة عملية daemon الخاصة بالجهاز (ليست إعدادات محمولة) =====
.claude.json
/daemon*
/jobs/
file-history/
plugins/.last_inuse_sweep
plugins/plugin-catalog-cache.json
plugins/installed_plugins.json
# مسارات مطلقة + طوابع زمنية متغيرة؛ المصدر الحقيقي في settings.json
plugins/known_marketplaces.json

# ===== نظام التشغيل =====
Thumbs.db
.DS_Store

# ===== إضافات جهاز جديد (2026-08-03) =====
# سجلات وقت التشغيل ومقاييس خاصة بالجهاز
bash-commands.log
cost-tracker.log
metrics/
session-data/
# ذاكرة مؤقتة لشريط الحالة claude-hud (ملفات hash خاصة بالجهاز)
plugins/claude-hud/
# نسخ احتياطية محلية لملف الإعدادات
settings.json.bak*
settings.json.original
*.bak
