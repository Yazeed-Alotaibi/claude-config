  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "theme": "dark",
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "permissions": {
    "allow": [
      "PowerShell"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "subagentStatusLine": {
    "type": "command",
    "command": "\"C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe\" -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"C:\\Users\\PC\\.claude\\coralline\\statusline.ps1\" --subagent"
  },
  "editorMode": "normal",
  "autoScrollEnabled": true
}
