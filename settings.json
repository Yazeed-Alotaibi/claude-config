{
  "env": {},
  "permissions": {
    "allow": [
      "PowerShell"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Windows\\System32\\conhost.exe",
            "args": [
              "--headless",
              "C:\\Windows\\System32\\cmd.exe",
              "/d",
              "/c",
              "%USERPROFILE%\\.orca\\agent-hooks\\claude-hook.cmd"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Windows\\System32\\conhost.exe",
            "args": [
              "--headless",
              "C:\\Windows\\System32\\cmd.exe",
              "/d",
              "/c",
              "%USERPROFILE%\\.orca\\agent-hooks\\claude-hook.cmd"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Windows\\System32\\conhost.exe",
            "args": [
              "--headless",
              "C:\\Windows\\System32\\cmd.exe",
              "/d",
              "/c",
              "%USERPROFILE%\\.orca\\agent-hooks\\claude-hook.cmd"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Windows\\System32\\conhost.exe",
            "args": [
              "--headless",
              "C:\\Windows\\System32\\cmd.exe",
              "/d",
              "/c",
              "%USERPROFILE%\\.orca\\agent-hooks\\claude-hook.cmd"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Windows\\System32\\conhost.exe",
            "args": [
              "--headless",
              "C:\\Windows\\System32\\cmd.exe",
              "/d",
              "/c",
              "%USERPROFILE%\\.orca\\agent-hooks\\claude-hook.cmd"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "TeammateIdle": [
