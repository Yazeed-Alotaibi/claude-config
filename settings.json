      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Windows\\System32\\conhost.exe",
            "args": [
              "--headless",
              "C:\\Windows\\System32\\cmd.exe",
              "/d",
              "/c",
              "%USERPROFILE%\\.orca\\agent-hooks\\claude-hook.cmd"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$PASEO_TERMINAL_ID\" ]; then \"${PASEO_HOOK_CLI:-paseo}\" hooks claude Stop; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Windows\\System32\\conhost.exe",
            "args": [
              "--headless",
              "C:\\Windows\\System32\\cmd.exe",
              "/d",
              "/c",
              "%USERPROFILE%\\.orca\\agent-hooks\\claude-hook.cmd"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$PASEO_TERMINAL_ID\" ]; then \"${PASEO_HOOK_CLI:-paseo}\" hooks claude StopFailure; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Windows\\System32\\conhost.exe",
            "args": [
              "--headless",
              "C:\\Windows\\System32\\cmd.exe",
              "/d",
              "/c",
