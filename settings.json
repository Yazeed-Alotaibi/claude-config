{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$PASEO_TERMINAL_ID\" ]; then \"${PASEO_HOOK_CLI:-paseo}\" hooks claude Notification; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Windows\\System32\\conhost.exe",
            "args": [
              "--headless",
              "C:\\Windows\\System32\\cmd.exe",
              "/d",
              "/c",
              "%USERPROFILE%\\.orca\\agent-hooks\\claude-hook.cmd"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Windows\\System32\\conhost.exe",
            "args": [
              "--headless",
              "C:\\Windows\\System32\\cmd.exe",
              "/d",
              "/c",
              "%USERPROFILE%\\.orca\\agent-hooks\\claude-hook.cmd"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Windows\\System32\\conhost.exe",
            "args": [
              "--headless",
              "C:\\Windows\\System32\\cmd.exe",
              "/d",
              "/c",
              "%USERPROFILE%\\.orca\\agent-hooks\\claude-hook.cmd"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Windows\\System32\\conhost.exe",
            "args": [
              "--headless",
              "C:\\Windows\\System32\\cmd.exe",
              "/d",
              "/c",
              "%USERPROFILE%\\.orca\\agent-hooks\\claude-hook.cmd"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
