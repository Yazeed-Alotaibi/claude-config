            "args": [
              "--headless",
              "C:\\Windows\\System32\\cmd.exe",
              "/d",
              "/c",
              "%USERPROFILE%\\.orca\\agent-hooks\\claude-hook.cmd"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Windows\\System32\\conhost.exe",
            "args": [
              "--headless",
              "C:\\Windows\\System32\\cmd.exe",
              "/d",
              "/c",
              "%USERPROFILE%\\.orca\\agent-hooks\\claude-hook.cmd"
            ],
            "timeout": 10
          }
        ]
      }
